# Base URL of the core API as reached from the browser.
# Leave unset to run the web app against built-in simulated data.
VITE_CORE_API_URL=http://localhost:8080

# OIDC authority (Keycloak realm URL). Leave unset to run without login.
VITE_OIDC_AUTHORITY=http://localhost:8085/realms/opentreasury
VITE_OIDC_CLIENT_ID=opentreasury-web

{
  "name": "opentreasury",
  "version": "0.0.0",
  "private": true,
  "description": "Open-source public-finance transparency and treasury-management platform.",
  "license": "Apache-2.0",
  "packageManager": "pnpm@10.34.4",
  "scripts": {
    "build": "pnpm -r build",
    "check": "pnpm -r check",
    "dev:web": "pnpm --filter @opentreasury/web dev",
    "dev:mobile": "pnpm --filter @opentreasury/mobile start",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck"
  },
  "engines": {
    "node": ">=20",
    "pnpm": ">=10"
  }
}
